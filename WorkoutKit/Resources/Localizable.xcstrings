      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discards the manual entry and closes the sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容を破棄してシートを閉じます"
          }
        }
      }
    },
    "a11y.manual-entry.save.hint": {
      "comment": "F3 a11y. ManualEntryView toolbar の Save ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the entered workout to history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力したワークアウトを履歴に保存します"
          }
        }
      }
    }
  }
}
