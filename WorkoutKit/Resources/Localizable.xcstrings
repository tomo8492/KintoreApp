        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種目タイプ・部位・器具のフィルタを開きます"
          }
        }
      }
    },
    "a11y.library.filters.none": {
      "comment": "F3 a11y. フィルタ未適用時の value。",
