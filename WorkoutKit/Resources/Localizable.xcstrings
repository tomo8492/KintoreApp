    "a11y.builder.choose.regenerate.hint": {
      "comment": "F3 a11y. ChooseMode の再生成ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenerates the workout while keeping locked exercises."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック済みの種目を残してワークアウトを再生成します"
          }
        }
      }
    },
    "a11y.builder.choose.toggle.hint": {
      "comment": "F3 a11y. ChooseMode の候補行のヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to lock or unlock this exercise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップで種目のロックを切り替えます"
          }
        }
      }
    },
    "a11y.builder.equipment.toggle.hint": {
      "comment": "F3 a11y. EquipmentChip の VoiceOver ヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to toggle this equipment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップでこの器具の選択を切り替えます"
          }
        }
      }
    },
    "a11y.builder.generate.hint": {
      "comment": "F3 a11y. Builder bottom bar — generate ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generates a workout from your selections."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内容からワークアウトを生成します"
          }
        }
      }
    },
    "a11y.builder.muscle.diagram.label": {
      "comment": "F3 a11y. BodyDiagramView 全体のラベル。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body muscle diagram. Tap a region to select it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人体図ピッカー。タップで部位を選択します"
          }
        }
      }
    },
    "a11y.builder.muscle.toggle.hint": {
      "comment": "F3 a11y. MuscleChip のヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to toggle this muscle group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップでこの部位の選択を切り替えます"
          }
        }
      }
    },
    "a11y.builder.next.hint": {
      "comment": "F3 a11y. Builder bottom bar — next ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advances to the next step."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のステップに進みます"
          }
        }
      }
    },
    "a11y.builder.result.locked": {
      "comment": "F3 a11y. ResultStepView の section row — ロック状態。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック中"
          }
        }
      }
    },
    "a11y.builder.result.row %lld %@": {
      "comment": "F3 a11y. ResultStepView の section row label。%1: index, %2: 種目名。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Item %1$lld, %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 番目、%2$@"
          }
        }
      }
    },
    "a11y.builder.result.start.hint": {
      "comment": "F3 a11y. ResultStepView の Start Session ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begins the workout session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを開始します"
          }
        }
      }
    },
    "a11y.builder.result.unlocked": {
      "comment": "F3 a11y. ResultStepView の section row — 未ロック状態。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未ロック"
          }
        }
      }
    },
    "a11y.builder.shuffle.hint": {
      "comment": "F3 a11y. ShuffleMode の再シャッフルボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
