    "a11y.library.youtube.locked.hint": {
      "comment": "F3 a11y. ExerciseDetailView の YouTube ボタン (Pro 未解放) ヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro feature — opens the paywall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 機能 — Paywall を開きます"
          }
        }
      }
    },
    "a11y.library.youtube.unlocked.hint": {
      "comment": "F3 a11y. ExerciseDetailView の YouTube ボタン (Pro 解放済) ヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the YouTube app to search for this exercise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube アプリで種目を検索します"
          }
        }
      }
    },
    "a11y.manual-entry.cancel.hint": {
      "comment": "F3 a11y. ManualEntryView toolbar の Cancel ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discards the manual entry and closes the sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容を破棄してシートを閉じます"
          }
        }
      }
    },
    "a11y.manual-entry.save.hint": {
      "comment": "F3 a11y. ManualEntryView toolbar の Save ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the entered workout to history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力したワークアウトを履歴に保存します"
          }
        }
      }
    },
    "a11y.paywall.purchase.hint": {
      "comment": "F3 a11y. PaywallView の購入ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts the App Store purchase flow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store の購入フローを開始します"
          }
        }
      }
    },
    "a11y.paywall.restore.hint": {
      "comment": "F3 a11y. PaywallView の復元ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores any prior Pro purchase from your Apple ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID から過去の Pro 購入を復元します"
          }
        }
      }
    },
    "a11y.session.complete.hint": {
      "comment": "F3 a11y. SessionSetInputPanel の完了ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records the current set and starts the rest interval."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のセットを記録し、休憩タイマーを開始します"
          }
        }
      }
