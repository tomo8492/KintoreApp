        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分"
          }
        }
      }
    },
    "a11y.data-io.export.hint": {
      "comment": "F3 a11y. DataIOView の Export ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro feature — exports your history as a CSV file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 機能 — 履歴を CSV ファイルとして書き出します"
          }
        }
      }
    },
    "a11y.data-io.import.hint": {
      "comment": "F3 a11y. DataIOView の Import ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro feature — imports exercises from a file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 機能 — ファイルから種目を取り込みます"
          }
        }
      }
    },
    "a11y.history.manual-entry.hint": {
      "comment": "F3 a11y. HistoryView toolbar — 手動ログ追加のヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs a workout you completed outside the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ外で行った種目を手動で記録します"
          }
        }
      }
    },
    "a11y.history.show-all.hint": {
      "comment": "F3 a11y. HistoryView の Show all ボタンのヒント。",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro feature — unlocks history older than 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 機能 — 31日以前の履歴を表示します"
          }
        }
      }
    },
