<?xml version="1.0" encoding="UTF-8"?>
<!--
    PrivacyInfo.xcprivacy
    CLAUDE.md §-1.9 / §-1.11 準拠。
    収集情報: なし。トラッキング: なし。
    Required Reason API は現状 UserDefaults のみ(@AppStorage / SettingsKey 経由)。
    FileTimestamp 系 API (modificationDate / creationDate / attributesOfItem 等) は
    本アプリ・テストいずれからも未参照のため宣言から外している。
    SDK 依存 (RevenueCat 等) が内部で使う場合は SDK 自身の PrivacyInfo に集約される。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
