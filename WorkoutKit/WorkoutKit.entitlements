<?xml version="1.0" encoding="UTF-8"?>
<!--
    WorkoutKit.entitlements
    CLAUDE.md §-1.5 準拠。App Group は v1.0 で未使用でも初日から作成する。
    将来 watchOS / Widget で必須になる際の付け替えコストを避ける。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.tomo.workoutkit</string>
    </array>
</dict>
</plist>
