<?xml version="1.0" encoding="UTF-8"?>
<!--
    WorkoutKitWatchApp.entitlements
    CLAUDE.md v1.0 §11-4 / Phase 2-2 準拠。
    watchOS 単体アプリが App 本体 / WorkoutKitWatch Widget と同じ App Group を
    共有するための entitlement(WorkoutKitWatch.entitlements と同一内容)。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.tomo.workoutkit</string>
    </array>
</dict>
</plist>
